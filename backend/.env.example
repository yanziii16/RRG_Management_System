# Server configuration
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"
JWT_SECRET="luckystar-dev-session-secret-change-in-production"

# Frontend API base URL (defaults  to /api on same origin)
VITE_API_BASE_URL="/api"

# Future PostgreAQL connection (for production migration)
DATABASE_URL="postgresql://postgres:password@localhost:5432/luckystar_resort"
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="luckystar_resort"
DB_USER="postgres"
DB_PASSWORD="password"